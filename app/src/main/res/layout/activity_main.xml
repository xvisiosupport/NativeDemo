<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tech_bg_primary"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- ═══ Splash Video Layer (Full-screen overlay) ═══ -->
        <FrameLayout
            android:id="@+id/splash_layer"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:visibility="gone"
            android:background="@color/tech_bg_primary">

            <VideoView
                android:id="@+id/videoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Bottom gradient fade for seamless transition -->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_splash_fade" />
        </FrameLayout>

        <!-- ═══ Top Bar: Logo + SLAM Mode Controls ═══ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tech_bg_secondary"
            android:paddingLeft="12dp"
            android:paddingTop="10dp"
            android:paddingRight="12dp"
            android:paddingBottom="10dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/logo"
                android:layout_width="80dp"
                android:layout_height="56dp"
                android:visibility="gone"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@mipmap/logo" />

            <!-- SLAM Mode Radio Group -->
            <RadioGroup
                android:id="@+id/radio_slam_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintBottom_toTopOf="@id/ll_checkbox"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/logo"
                app:layout_constraintTop_toTopOf="parent">

                <RadioButton
                    android:id="@+id/radio_mixed"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:button="@null"
                    android:checked="true"
                    android:gravity="center"
                    android:textColor="@color/tech_text_secondary"
                    android:text="MIXED"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radio_edge"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:button="@null"
                    android:checked="false"
                    android:gravity="center"
                    android:textColor="@color/tech_text_secondary"
                    android:text="EDGE+"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </RadioGroup>

            <!-- SLAM / IMU Checkboxes -->
            <LinearLayout
                android:id="@+id/ll_checkbox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/logo"
                app:layout_constraintTop_toBottomOf="@id/radio_slam_mode">

                <CheckBox
                    android:id="@+id/checkbox_slam"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="16dp"
                    android:buttonTint="@color/tech_accent"
                    android:checked="false"
                    android:text="SLAM"
                    android:textColor="@color/tech_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/checkbox_imu"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:buttonTint="@color/tech_accent"
                    android:checked="false"
                    android:text="IMU"
                    android:textColor="@color/tech_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Tech Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_tech" />

        <!-- ═══ Accelerometer Display ═══ -->
        <include
            layout="@layout/accelerometer_display"
            android:id="@+id/accelerometerDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ═══ Pose Display ═══ -->
        <include
            layout="@layout/pose_display"
            android:id="@+id/poseDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Hidden ASR / Test button row -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/bt_layout"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:visibility="gone"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp">

            <Button
                android:id="@+id/bt_startAsr"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_tech_button"
                android:minHeight="0dp"
                android:text="startASR"
                android:textColor="@color/tech_text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/bt_test_func"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_tech_button"
                android:minHeight="0dp"
                android:onClick="testFunc"
                android:text="testBtn"
                android:textColor="@color/tech_text_primary"
                android:textSize="11sp" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- ═══ TEST PANEL (Tech Card) ═══ -->
        <LinearLayout
            android:id="@+id/test_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/bg_tech_panel"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="12dp"
            android:paddingRight="14dp"
            android:paddingBottom="14dp">

            <!-- Panel Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="[ CONTROL PANEL ]"
                    android:textAllCaps="true"
                    android:textColor="@color/tech_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_record_indicator" />
            </RelativeLayout>

            <!-- ── Electrochromic Control ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▸ ELECTROCHROMIC"
                android:textColor="@color/tech_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bt_electro_minus"
                    android:layout_width="38dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_tech_button"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="−"
                    android:textColor="@color/tech_accent"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_electro_level"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tech_status"
                    android:gravity="center"
                    android:text="10"
                    android:textColor="@color/tech_accent"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <Button
                    android:id="@+id/bt_electro_plus"
                    android:layout_width="38dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_tech_button"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="+"
                    android:textColor="@color/tech_accent"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Divider line inside panel -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/tech_divider" />

            <!-- ── Volume Control ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▸ VOLUME"
                android:textColor="@color/tech_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bt_volume_minus"
                    android:layout_width="38dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_tech_button"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="−"
                    android:textColor="@color/tech_blue"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_volume_level"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tech_status"
                    android:gravity="center"
                    android:text="0/0"
                    android:textColor="@color/tech_blue"
                    android:textSize="15sp"
                    android:fontFamily="monospace" />

                <Button
                    android:id="@+id/bt_volume_plus"
                    android:layout_width="38dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_tech_button"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="+"
                    android:textColor="@color/tech_blue"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/tech_divider" />

            <!-- ── Mic Test ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▸ MIC TEST"
                android:textColor="@color/tech_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bt_mic_record"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tech_button"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="0dp"
                    android:text="REC"
                    android:textColor="@color/tech_amber"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/bt_mic_play"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tech_button"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="0dp"
                    android:text="PLAY"
                    android:textColor="@color/tech_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/bt_mic_stop"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tech_button"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="0dp"
                    android:text="STOP"
                    android:textColor="@color/tech_red"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Mic Status Display -->
            <TextView
                android:id="@+id/tv_mic_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_tech_status"
                android:paddingLeft="10dp"
                android:paddingTop="7dp"
                android:paddingRight="10dp"
                android:paddingBottom="7dp"
                android:text="◆ MIC IDLE"
                android:textColor="@color/tech_text_hint"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/tech_divider" />

            <!-- ── Vsync Test ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▸ VSYNC MONITOR"
                android:textColor="@color/tech_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/bt_vsync_toggle"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_tech_button_accent"
                android:minHeight="0dp"
                android:text="▶ START VSYNC"
                android:textColor="@color/tech_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Vsync Status Display -->
            <TextView
                android:id="@+id/tv_vsync_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_tech_status"
                android:paddingLeft="10dp"
                android:paddingTop="7dp"
                android:paddingRight="10dp"
                android:paddingBottom="7dp"
                android:text="◆ VSYNC IDLE"
                android:textColor="@color/tech_text_hint"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- ═══ Camera Stream Selection ═══ -->
        <RadioGroup
            android:id="@+id/radio_camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <RadioButton
                android:id="@+id/radio_rgb"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:button="@null"
                android:checked="false"
                android:gravity="center"
                android:textColor="@color/tech_text_secondary"
                android:text="RGB"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/radio_tof"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:button="@null"
                android:checked="false"
                android:gravity="center"
                android:textColor="@color/tech_text_secondary"
                android:text="TOF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/radio_stereo"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:button="@null"
                android:checked="false"
                android:gravity="center"
                android:textColor="@color/tech_text_secondary"
                android:text="STEREO"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/radio_sgbm"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:button="@null"
                android:checked="false"
                android:gravity="center"
                        android:textColor="@color/tech_text_secondary"
                        android:text="SGBM"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RadioGroup>

        <!-- ═══ Stream Info Bar (Resolution + FPS) ═══ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_rgb_stream"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_tech_status"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <Button
                android:id="@+id/button_rgb"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:visibility="gone"
                android:background="@drawable/bg_tech_button"
                android:minHeight="0dp"
                android:text="solution"
                android:textColor="@color/tech_text_secondary"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_rgb_solution"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text=""
                android:textColor="@color/tech_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/tv_rgb_fps" />

            <TextView
                android:id="@+id/tv_rgb_fps"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical|end"
                android:text=""
                android:textColor="@color/tech_green"
                android:textSize="12sp"
                android:fontFamily="monospace"
                app:layout_constraintRight_toRightOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ═══ RGB Stream Preview ═══ -->
        <ImageView
            android:id="@+id/rgbView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_tech_status" />

        <!-- ASR Result (hidden) -->
        <TextView
            android:id="@+id/tv_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tech_status"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:text="asr result"
            android:textColor="@color/tech_amber"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- ═══ TOF Stream Preview (Dual View) ═══ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_tof"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:padding="2dp">

            <ImageView
                android:id="@+id/tofView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:padding="2dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/tofView2"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/tofView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:padding="2dp"
                app:layout_constraintLeft_toRightOf="@id/tofView"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</ScrollView>
