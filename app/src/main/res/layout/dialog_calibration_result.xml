<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="24dp"
    android:layout_marginRight="24dp"
    android:background="@drawable/bg_tech_panel"
    android:orientation="vertical"
    android:paddingLeft="18dp"
    android:paddingTop="18dp"
    android:paddingRight="18dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/tv_calib_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SAVE RESULT"
        android:textAllCaps="true"
        android:textColor="@color/tech_accent"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/tech_divider" />

    <TextView
        android:id="@+id/tv_calib_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tech_status"
        android:paddingLeft="12dp"
        android:paddingTop="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/tech_text_primary"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp" />

    <Button
        android:id="@+id/bt_calib_dialog_ok"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_tech_button_accent"
        android:minHeight="0dp"
        android:text="OK"
        android:textColor="@color/tech_accent"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
